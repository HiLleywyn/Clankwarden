{
  "manifest_version": "1",
  "bot": {
    "slug": "clanksimus-prime",
    "name": "Clanksimus Prime",
    "version": "1.0.0",
    "description": "Free server backups, templates, chatlogs, sync and containment, rendered in Discord Components V2.",
    "author": "HiLleywyn",
    "repo": "hilleywyn/clanksimus-prime"
  },
  "channels": ["discord"],
  "runtime": {
    "dockerfile": "Dockerfile",
    "entrypoint": "main.py"
  },
  "credentials": [
    { "key": "DISCORD_TOKEN", "label": "Discord bot token", "secret": true }
  ],
  "provision": {
    "database": "postgres",
    "redis": true
  },
  "features": [
    "cogs.meta",
    "cogs.modlog",
    "cogs.settings",
    "cogs.backups",
    "cogs.templates",
    "cogs.chatlog",
    "cogs.sync",
    "cogs.importexport",
    "cogs.clank"
  ],
  "settings": {
    "groups": [
      {
        "id": "general",
        "label": "General",
        "fields": [
          { "key": "PREFIX", "type": "string", "label": "Command prefix", "default": "." },
          { "key": "API_PORT", "type": "number", "label": "API / health port", "default": 8080 },
          { "key": "DISCORD_CLIENT_ID", "type": "string", "label": "Discord application (client) ID", "required": true, "help": "Required. From the Discord developer portal OAuth2 page; powers the Invite button." }
        ]
      },
      {
        "id": "backups",
        "label": "Backups",
        "fields": [
          { "key": "BACKUP_MAX_PER_USER", "type": "number", "label": "Max backups per user", "default": 50, "min": 1, "max": 1000 }
        ]
      },
      {
        "id": "api",
        "label": "REST API",
        "fields": [
          { "key": "CLANK_API_KEY", "type": "secret", "label": "API key (enables /api/v2)" }
        ]
      },
      {
        "id": "containment",
        "label": "Containment (.clank)",
        "fields": [
          { "key": "CLANKER_ROLE_ID", "type": "discord_role", "label": "Clanker role", "help": "Containment role applied to clanked users." },
          { "key": "CLANK_CATEGORY_ID", "type": "discord_channel", "label": "Clanker category", "help": "Category the containment channels live under." },
          { "key": "CLANKTANK_CHANNEL_ID", "type": "discord_channel", "label": "Clanktank channel", "help": "Channel clankers are confined to." },
          { "key": "CLANKTANK_LOG_CHANNEL_ID", "type": "discord_channel", "label": "Clanker log channel", "help": "Log for containment (clank/escape) events." },
          { "key": "CLANK_ESCAPE_THREAD_ID", "type": "discord_channel", "label": "Escape-room thread", "help": "Shared thread where escape-room cases are posted." },
          { "key": "CLANK_ESCAPE_WAIT_MINUTES", "type": "number", "label": "Reflection period (minutes)", "default": 5, "min": 1, "max": 120, "help": "Mandatory reflection wait before an escape unlocks." },
          { "key": "CLANKER_HUNTER_ROLE_ID", "type": "discord_role", "label": "Clanker hunter role", "help": "Members of this role can report scammers in the hunter channel." },
          { "key": "CLANKER_HUNTER_CHANNEL_ID", "type": "discord_channel", "label": "Clanker hunter channel", "help": "Channel where hunters post reports that auto-clank flagged users." }
        ]
      },
      {
        "id": "moderation",
        "label": "Moderation logs",
        "fields": [
          { "key": "MOD_LOG_CHANNEL_ID", "type": "discord_channel", "label": "Mod log channel", "help": "Comprehensive moderation log for every tracked event." }
        ]
      }
    ]
  }
}
