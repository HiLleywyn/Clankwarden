# ── Clanksimus Prime configuration ───────────────────────────────────────────
# Copy to .env for local development. On Railway, set these as service variables.

# Required ---------------------------------------------------------------------
DISCORD_TOKEN=                       # bot token from the Discord developer portal
DATABASE_URL=postgresql://user:pass@host:5432/clanksimus

# Core -------------------------------------------------------------------------
PREFIX=.                             # command prefix (".clank", ".backup", ...)
API_PORT=8080                        # embedded REST API + /health port
DEBUG=false

# REST API (optional) ----------------------------------------------------------
CLANK_API_KEY=                       # set to enable /api/v2 (sent as X-API-Key)

# Discord OAuth (optional, for invite link) ------------------------------------
DISCORD_CLIENT_ID=

# Backups ----------------------------------------------------------------------
BACKUP_MAX_PER_USER=50

# Containment (.clank) ---------------------------------------------------------
CLANKER_ROLE_ID=                     # role applied to contained accounts
CLANKTANK_CHANNEL_ID=                # the "tank" channel
CLANKTANK_LOG_CHANNEL_ID=            # mod log channel (optional)
CLANK_ESCAPE_THREAD_ID=              # shared escape-room thread (optional)
CLANK_ESCAPE_WAIT_MINUTES=8

# Redis (optional) -------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
